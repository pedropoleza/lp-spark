# Stripe — chave secreta do servidor. NUNCA exponha no frontend.
STRIPE_SECRET_KEY=sk_test_xxx

# URL pública base usada para success/cancel URLs e Open Graph.
NEXT_PUBLIC_BASE_URL=https://checkout.sparkleads.pro

# Stripe Price IDs (NÃO use Product IDs aqui).
# Crie os preços no dashboard do Stripe e cole os IDs "price_..." abaixo.
STRIPE_PRICE_STARTER=price_xxx_starter
STRIPE_PRICE_GROWTH=price_xxx_growth
STRIPE_PRICE_AGENCY=price_xxx_agency
